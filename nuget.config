<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Ubiety.Nbt is not on nuget.org yet, so it is restored from ./packages.
    Refresh it with: dotnet pack ..\ubiety\ubiety.nbt\src\ubiety.nbt -c Release -o packages
    Remove the "local" source once the package is published.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local" value="packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Ubiety.Nbt" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
