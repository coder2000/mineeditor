<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MineEditor.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:MineEditor.Core.Documents"
    xmlns:vm="using:MineEditor.ViewModels"
    xmlns:views="using:MineEditor.Views"
    NavigationCacheMode="Required">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox
                x:Name="DocumentPicker"
                MinWidth="320"
                PlaceholderText="Choose a file to edit"
                ItemsSource="{x:Bind ViewModel.Shell.Documents}"
                AutomationProperties.Name="Document"
                SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="docs:NbtDocument">
                        <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="{x:Bind Location}">
                            <TextBlock Text="{x:Bind Title}" />
                            <TextBlock Text="•" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{x:Bind IsDirty, Mode=OneWay}" ToolTipService.ToolTip="Unsaved changes" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Click="OnOpenFileClick" ToolTipService.ToolTip="Open any NBT file">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="OpenFile" />
                    <TextBlock Text="Open file…" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320" />
                <ColumnDefinition Width="2*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="4">
                <TreeView
                    x:Name="Tree"
                    ItemsSource="{x:Bind ViewModel.RootNodes}"
                    SelectionMode="Single"
                    Expanding="OnTreeExpanding"
                    SelectionChanged="OnTreeSelectionChanged">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NbtNodeViewModel">
                            <TreeViewItem
                                ItemsSource="{x:Bind Children}"
                                HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border MinWidth="28" Padding="4,0" CornerRadius="3" VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind Badge, Mode=OneWay}" FontFamily="{StaticResource CodeFontFamily}" FontSize="11"
                                                   HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Summary, Mode=OneWay}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontFamily="{StaticResource CodeFontFamily}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <TextBlock Grid.Column="1" Visibility="{x:Bind views:EditorPage.NoSelection(ViewModel.Selected), Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Select a tag to edit it." />

            <ScrollViewer Grid.Column="1" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <StackPanel Spacing="16" Padding="0,0,12,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Selected.Label, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.TypeName, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.PathText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>

                    <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                             IsClosable="False" />

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CanRename, Mode=OneWay}">
                        <TextBlock Text="Name" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnNameKeyDown"
                                     AutomationProperties.Name="Tag name" />
                            <Button Grid.Column="1" Content="Rename" Click="OnRenameClick" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CanEditValue, Mode=OneWay}">
                        <TextBlock Text="Value" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource CodeFontFamily}" KeyDown="OnValueKeyDown"
                                     AutomationProperties.Name="Tag value" />
                            <Button Grid.Column="1" Content="Apply" Style="{StaticResource AccentButtonStyle}" Click="OnApplyValueClick" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <DropDownButton x:Name="AddButton" Visibility="{x:Bind ViewModel.CanAddChild, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock Text="Add" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="AddMenu" Placement="BottomEdgeAlignedLeft" Opening="OnAddMenuOpening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Click="OnDuplicateClick" IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Copy" />
                                <TextBlock Text="Duplicate" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnRemoveClick" IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Delete" ScopeOwner="{x:Bind Tree}" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="SNBT" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Copy" Click="OnCopySnbtClick" ToolTipService.ToolTip="Copy this tag as SNBT" />
                                <Button Content="Edit as text" Click="OnLoadSnbtClick" />
                            </StackPanel>
                        </Grid>
                        <TextBox
                            Text="{x:Bind ViewModel.SnbtText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            IsSpellCheckEnabled="False"
                            FontFamily="{StaticResource CodeFontFamily}"
                            MinHeight="160"
                            MaxHeight="520"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            PlaceholderText="Choose Edit as text to change this tag and everything in it as SNBT."
                            AutomationProperties.Name="SNBT text" />
                        <Button Content="Apply SNBT" HorizontalAlignment="Right" Click="OnApplySnbtClick"
                                IsEnabled="{x:Bind views:EditorPage.HasText(ViewModel.SnbtText), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
