<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MineEditor.Views.WorldPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MineEditor.Controls">

    <ScrollViewer>
        <StackPanel Padding="32,24" MaxWidth="900" HorizontalAlignment="Left">
            <Grid ColumnSpacing="16" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image x:Name="Icon" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="WorldName" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="WorldPath" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Center" Click="OnOpenInEditorClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                        <TextBlock Text="Edit level.dat as NBT" />
                    </StackPanel>
                </Button>
            </Grid>

            <controls:FieldForm x:Name="Form" />
        </StackPanel>
    </ScrollViewer>
</Page>
