<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MineEditor.Controls.FieldForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MineEditor.Controls"
    xmlns:vm="using:MineEditor.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="TextTemplate" x:DataType="vm:FieldViewModel">
            <Grid ColumnSpacing="16" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Label}" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind controls:FieldForm.VisibleIf(Description)}" />
                </StackPanel>
                <StackPanel Grid.Column="1" MaxWidth="360" HorizontalAlignment="Left" Spacing="4">
                    <TextBox Text="{x:Bind Text, Mode=TwoWay}" MinWidth="240" KeyDown="OnTextBoxKeyDown" AutomationProperties.Name="{x:Bind Label}" />
                    <TextBlock Text="{x:Bind Error, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Visibility="{x:Bind HasError, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ToggleTemplate" x:DataType="vm:FieldViewModel">
            <Grid ColumnSpacing="16" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Label}" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind controls:FieldForm.VisibleIf(Description)}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsOn, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Label}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceTemplate" x:DataType="vm:FieldViewModel">
            <Grid ColumnSpacing="16" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" MinWidth="240" ItemsSource="{x:Bind Choices}" SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Bind Label}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReadOnlyTemplate" x:DataType="vm:FieldViewModel">
            <Grid ColumnSpacing="16" Padding="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Text}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <controls:FieldTemplateSelector
            x:Key="FieldSelector"
            Text="{StaticResource TextTemplate}"
            Toggle="{StaticResource ToggleTemplate}"
            Choice="{StaticResource ChoiceTemplate}"
            ReadOnly="{StaticResource ReadOnlyTemplate}" />
    </UserControl.Resources>

    <ItemsControl x:Name="GroupList">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FieldGroup">
                <StackPanel Margin="0,0,0,16" Spacing="8">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <ItemsControl ItemsSource="{x:Bind Fields}" ItemTemplateSelector="{StaticResource FieldSelector}" />
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
